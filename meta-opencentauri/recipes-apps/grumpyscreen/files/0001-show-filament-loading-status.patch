+void PromptPanel::update_filament_state(const json &status) {
+  for (const char *object : {"extruder", "filament_switch_sensor filament_sensor"}) {
+    if (status.contains(object)) filament_state[object].merge_patch(status[object]);
+  }
+  update_filament_status();
+}
+
+void PromptPanel::update_filament_status() {
+  if (filament_status_label == NULL) return;
+  const auto text = FilamentPrompt::status(filament_state, lv_tick_elaps(filament_step_started));
+  if (text != lv_label_get_text(filament_status_label)) {
+    lv_label_set_text(filament_status_label, text.c_str());
+  }
 }
 
