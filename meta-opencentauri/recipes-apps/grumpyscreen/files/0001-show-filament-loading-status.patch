diff --git a/src/filament_prompt.h b/src/filament_prompt.h
new file mode 100644
--- /dev/null
+++ b/src/filament_prompt.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include "hv/json.hpp"
+#include <cmath>
+#include <cstdint>
+#include <iomanip>
+#include <sstream>
+#include <string>
+
+namespace FilamentPrompt {
+
+// These are the titles used by the COSMOS loading macros. Other prompts keep
+// their existing layout, including unload, probing and third-party dialogs.
+inline bool matches(const std::string &title) {
+  return title == "Load Filament" || title == "Loading Filament" ||
+         title == "Finalizing filament load";
+}
+
+inline std::string status(const nlohmann::json &state, uint32_t elapsed_ms) {
+  auto temperature = [&state](const char *path) {
+    const auto ptr = nlohmann::json::json_pointer(path);
+    if (!state.contains(ptr) || !state[ptr].is_number()) return std::string("--");
+    const double value = state[ptr].get<double>();
+    if (!std::isfinite(value)) return std::string("--");
+    std::ostringstream text;
+    text << std::fixed << std::setprecision(0) << value;
+    return text.str();
+  };
+
+  std::string sensor = "Unavailable";
+  const auto sensor_ptr = nlohmann::json::json_pointer(
+    "/filament_switch_sensor filament_sensor");
+  if (state.contains(sensor_ptr) && state[sensor_ptr].is_object()) {
+    const auto &s = state[sensor_ptr];
+    if (s.contains("enabled") && s["enabled"].is_boolean()) {
+      if (!s["enabled"].get<bool>()) sensor = "Disabled";
+      else if (s.contains("filament_detected") && s["filament_detected"].is_boolean()) {
+        sensor = s["filament_detected"].get<bool>() ? "Detected" : "Not detected";
+      }
+    }
+  }
+
+  const auto seconds = elapsed_ms / 1000;
+  std::ostringstream text;
+  text << "Nozzle: " << temperature("/extruder/temperature")
+       << " °C / Target: " << temperature("/extruder/target") << " °C\n"
+       << "Filament sensor: " << sensor << "\nTime in step: "
+       << seconds / 60 << ':' << std::setfill('0') << std::setw(2) << seconds % 60;
+  return text.str();
+}
+}
