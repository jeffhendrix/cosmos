diff --git a/tests/test_filament_prompt.cpp b/tests/test_filament_prompt.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_filament_prompt.cpp
@@ -0,0 +1,46 @@
+#include "filament_prompt.h"
+
+#include <cassert>
+#include <iostream>
+
+using json = nlohmann::json;
+
+int main() {
+  assert(FilamentPrompt::matches("Load Filament"));
+  assert(FilamentPrompt::matches("Loading Filament"));
+  assert(FilamentPrompt::matches("Finalizing filament load"));
+  assert(!FilamentPrompt::matches("Unload completed"));
+  assert(!FilamentPrompt::matches("Manual Probe"));
+
+  json state = {
+    {"extruder", {{"temperature", 147.2}, {"target", 220.0}}},
+    {"filament_switch_sensor filament_sensor",
+      {{"enabled", true}, {"filament_detected", false}}}
+  };
+  assert(FilamentPrompt::status(state, 65000) ==
+         "Nozzle: 147 °C / Target: 220 °C\n"
+         "Filament sensor: Not detected\nTime in step: 1:05");
+
+  // A target-only delta must retain the last measured temperature.
+  state.merge_patch({{"extruder", {{"target", 240}}}});
+  assert(FilamentPrompt::status(state, 0).find(
+    "Nozzle: 147 °C / Target: 240 °C") == 0);
+  state["filament_switch_sensor filament_sensor"]["filament_detected"] = true;
+  assert(FilamentPrompt::status(state, 1999).find(
+    "Filament sensor: Detected\nTime in step: 0:01") != std::string::npos);
+
+  // Disabled, absent and unknown data must not claim a healthy detection.
+  state["filament_switch_sensor filament_sensor"]["enabled"] = false;
+  assert(FilamentPrompt::status(state, 0).find("Filament sensor: Disabled")
+         != std::string::npos);
+  assert(FilamentPrompt::status(json::object(), 0) ==
+         "Nozzle: -- °C / Target: -- °C\n"
+         "Filament sensor: Unavailable\nTime in step: 0:00");
+  assert(FilamentPrompt::status(nullptr, 0).find("Nozzle: --") == 0);
+  state["extruder"] = {{"temperature", "invalid"}, {"target", nullptr}};
+  state["filament_switch_sensor filament_sensor"] = {{"enabled", true}};
+  assert(FilamentPrompt::status(state, 0).find("Nozzle: -- °C / Target: -- °C") == 0);
+  assert(FilamentPrompt::status(state, 0).find("Filament sensor: Unavailable")
+         != std::string::npos);
+  std::cout << "Filament prompt tests passed\n";
+}
